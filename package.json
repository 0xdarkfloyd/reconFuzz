{
  "name": "reconfuzz",
  "version": "0.1.0",
  "description": "Research fuzzer reconstructing V8/Chromium bug-finding strategies from historical POC corpora",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "server": "node dist/generator/server.js",
    "generate": "node dist/generator/index.js",
    "generate:gc": "node dist/generator/index.js --mode gc-only",
    "mutate": "node dist/mutator/index.js"
  },
  "keywords": [
    "fuzzing",
    "v8",
    "chromium",
    "javascript",
    "webassembly",
    "security-research"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@babel/generator": "^7.23.0",
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@babel/types": "^7.23.0"
  }
}
